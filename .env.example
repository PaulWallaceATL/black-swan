# Black Swan — AI configuration
# Copy this file to `.env.local` for local development and add the same keys in
# your Vercel project (Settings → Environment Variables) for deployment.

# REQUIRED — your OpenAI API key. Powers analysis, vision, and transcription.
# Do NOT prefix with NEXT_PUBLIC_ (that would expose it to the browser).
OPENAI_API_KEY=sk-your-key-here

# OPTIONAL — override the models. Defaults are vision-capable and broadly available.
# Bump the analysis model when your account has access (e.g. gpt-5.5, gpt-4o).
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
